# Django Settings
DEBUG=True
DJANGO_SECRET_KEY=django-insecure-dev-key-change-in-production
ALLOWED_HOSTS=localhost,127.0.0.1,*.render.com

# Database - leave DATABASE_URL blank for local SQLite.
# On Render, set DATABASE_URL to the PostgreSQL connection string Render provides.
DATABASE_URL=

# Redis (only needed if running Celery/WebSockets locally with Redis)
REDIS_HOST=localhost
REDIS_PORT=6379

# CORS
CORS_ORIGINS=http://localhost:3000,http://localhost:8000,http://127.0.0.1:3000

# Google OAuth (fill in during Google OAuth setup step)
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=

# Groq API - get free key at https://console.groq.com
GROQ_API_KEY=

# Firebase - get service account JSON from Firebase Console
FIREBASE_CREDENTIALS_JSON={}

# Celery
CELERY_BROKER_URL=redis://localhost:6379/0
CELERY_RESULT_BACKEND=redis://localhost:6379/0

# Logging
LOG_LEVEL=INFO
