{
  "expo": {
    "name": "Pulse",
    "slug": "pulse-chat",
    "version": "1.0.0",
    "orientation": "portrait",
    "userInterfaceStyle": "dark",
    "backgroundColor": "#0A0A0A",
    "splash": {
      "backgroundColor": "#0A0A0A"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.pulse.chat"
    },
    "android": {
      "package": "com.pulse.chat",
      "adaptiveIcon": {
        "backgroundColor": "#0A0A0A"
      }
    },
    "web": {
      "bundler": "metro"
    },
    "plugins": [
      "expo-router"
    ],
    "owner": "adebote-daniel",
    "projectId": "e75f38d6-9fbf-4f27-b5d6-3ff05c8b247f",
    "extra": {
      "router": {},
      "eas": {
        "projectId": "e06e439c-b23f-4ed5-a7fa-502af71c0ece"
      }
    }
  }
}
